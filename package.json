{
  "name": "makisend-poc",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test drizzle.config.ts vitest.config.ts",
    "lint:fix": "eslint src test drizzle.config.ts vitest.config.ts --fix",
    "d1:exec": "wrangler d1 execute makisend_db --local --file",
    "d1:exec:remote": "wrangler d1 execute makisend_db --remote --file",
    "user:create": "pnpm tsx src/core/create-user.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.25",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@emnapi/core": "2.0.0-alpha.4",
    "@emnapi/runtime": "2.0.0-alpha.4",
    "@hono/standard-validator": "^0.3.0",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@napi-rs/wasm-runtime": "1.2.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.6.25",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "generate-api-key": "^1.0.2",
    "hono": "^4.12.27",
    "htmlparser2": "^12.0.0",
    "inngest": "^4.18.0",
    "linkedom": "^0.18.13",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/ui": "^4.1.10",
    "better-sqlite3": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "pino-tee": "^0.4.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "sharp": "^0.35.3"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@emnapi/core",
        "@emnapi/runtime"
      ],
      "allowedVersions": {
        "@emnapi/core": ">=1.0.0",
        "@emnapi/runtime": ">=1.0.0"
      }
    }
  }
}
