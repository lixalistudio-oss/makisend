---
import { DEFAULT_LANGUAGE, LANGUAGES, LANGUAGE_STORAGE_KEY } from "@/i18n/config";

const languageCodes = LANGUAGES.map((lang) => lang.code);

interface Props {
	title?: string;
}

const { title = "MakiSend" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Sets <html lang> before the first paint; the islands then render in that language. -->
		<script is:inline define:vars={{ storageKey: LANGUAGE_STORAGE_KEY, codes: languageCodes, fallback: DEFAULT_LANGUAGE }}>
			try {
				var tags = [localStorage.getItem(storageKey)].concat(navigator.languages || [navigator.language]);
				var match = tags.map(function (tag) { return (tag || "").toLowerCase().split("-")[0]; }).find(function (code) { return codes.indexOf(code) !== -1; });
				document.documentElement.lang = match || fallback;
			} catch (e) {}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
