---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="MakiSend">
  <main class="flex min-h-screen items-center justify-center">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4">MakiSend</h1>
      <p class="text-muted-foreground mb-6">Transactional email service</p>
      <a href="/register" class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground hover:bg-primary/90">
        Get Started
      </a>
    </div>
  </main>
</Layout>
