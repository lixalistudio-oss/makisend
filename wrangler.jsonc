{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "makisend-poc",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// "vars": {
	//   "MY_VAR": "my-variable"
	// },
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"d1_databases": [
		{
			"binding": "makisend_db",
			"database_name": "makisend-db",
			"database_id": "fb679c0f-7a52-46c3-a859-0035767c06d2",
			"remote": true,
			    "migrations_dir": "./drizzle",                 // Matches the 'out' dir in Drizzle config
      			"migrations_pattern": "drizzle/*/migration.sql" // Tells Wrangler how to read nested Drizzle files
		}
	]
}