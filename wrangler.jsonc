{
	// Configuration used by the "Deploy to Cloudflare" button (README) and by Workers Builds
	// in a copy of this repository. Our own deployments (GitHub Actions) use
	// backend/wrangler.jsonc: keep both in sync, test/unit/config/root-wrangler.test.ts fails
	// when their bindings, crons or compatibility settings differ.
	//
	// During the button's set-up Cloudflare creates the D1 database and the queues under the
	// names chosen there, and writes the new database_id into the copy's wrangler.jsonc.
	"$schema": "backend/node_modules/wrangler/config-schema.json",
	"name": "makisend",
	"main": "./backend/src/index.ts",
	"tsconfig": "./backend/tsconfig.json",
	"compatibility_date": "2026-07-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// The Worker serves the dashboard too (Astro build, `pnpm run build`) and the API on the
	// same origin.
	"assets": {
		"directory": "./frontend/dist",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"vars": {
		// New-release check (dashboard banner): "off" stops every request to GitHub.
		"UPDATE_CHECK": "on",
		// Pre-filled with the official repository so the Deploy button form needs no input.
		// Change it to your copy, `owner/name` (e.g. "acme/makisend"), and the dashboard's
		// "Update" button opens its "Sync with upstream" workflow. Left on the official
		// repository (or empty), it links to the release and the update guide instead.
		"MAKISEND_REPOSITORY": "lixalistudio-oss/makisend"
	},
	// Cloudflare Email Service, for SMTP configurations on smtp.mx.cloudflare.net.
	"send_email": [{ "name": "EMAIL" }],
	"d1_databases": [
		{
			"binding": "makisend_db",
			"database_name": "makisend-db",
			"database_id": "00000000-0000-4000-8000-000000000000",
			"migrations_dir": "./backend/drizzle",
			"migrations_pattern": "backend/drizzle/*.sql"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "SEND_EMAIL_QUEUE",
				"queue": "makisend-send-email"
			},
			{
				"binding": "SEND_EMAIL_DLQ",
				"queue": "makisend-send-email-dlq"
			}
		],
		"consumers": [
			{
				"queue": "makisend-send-email",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"retry_delay": 30,
				"dead_letter_queue": "makisend-send-email-dlq"
			}
		]
	},
	"workflows": [
		{
			"name": "makisend-send-email",
			"binding": "SEND_EMAIL_WORKFLOW",
			"class_name": "SendEmailWorkflow"
		}
	],
	// Daily: SMTP health checks and the new-release check. Hourly: key rotation.
	"triggers": {
		"crons": ["17 3 * * *", "17 * * * *"]
	}
}
