{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "makisend-poc",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// `vars` are NOT inherited by environments, so preview declares its own below.
	// PORT is used by nodemailer (SmtpEmailTransport); without it the port silently
	// falls back to 465.
	"vars": {
		"PORT": "465"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"d1_databases": [
		{
			"binding": "makisend_db",
			"database_name": "makisend-db",
			"database_id": "fb679c0f-7a52-46c3-a859-0035767c06d2",
			"migrations_dir": "./drizzle",
			"migrations_pattern": "drizzle/*.sql"
		}
	],
	"env": {
		"preview": {
			"name": "makisend-poc-preview",
			"vars": {
				"PORT": "465"
			},
			"d1_databases": [
				{
					"binding": "makisend_db",
					"database_name": "makisend-db-preview",
					"database_id": "PREVIEW_DB_ID_PLACEHOLDER",
					"migrations_dir": "./drizzle",
					"migrations_pattern": "drizzle/*.sql"
				}
			]
		}
	}
}