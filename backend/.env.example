# ==========================================
# MakiSend Worker environment variables
# Local: fill in real values (cp .env.example .env)
# Prod: set secrets with `wrangler secret put <NAME>` (see README)
# ==========================================

# --- Security / encryption (required) ---
# AES-256 encryption key. 64-character hex string (32 bytes).
# Generate with: openssl rand -hex 32
# The legacy name AES_256_KEY is still read. Never replace the key outright once the
# database holds data: rotate it (see AGENTS.md, "Key rotation").
ENCRYPTION_KEY=your_64_character_hexadecimal_string_here
# Optional, during a key rotation only: previous keys, comma-separated (decrypt only).
# ENCRYPTION_KEY_PREVIOUS=

# --- Better Auth (required) ---
# Secret used by Better Auth to sign sessions and tokens.
BETTER_AUTH_SECRET=change_me_to_a_long_random_string
# Backend URL of this Worker.
BETTER_AUTH_URL=http://localhost:8787
# Frontend origin allowed for CORS / redirects.
FRONTEND_URL=http://localhost:4321
# Optional: "off" disables Better Auth rate limiting. Use only for local
# tests; leave unset in production.
# RATE_LIMIT=off

# --- Send quota (optional) ---
# Per-API-key quota on POST /send-email: <count>/<unit>, unit = s, min, hour or day.
# Unset (default): no quota, a self-hosted instance has a single owner. Set it when
# the API is reachable from the internet, so a leaked key cannot drain your SMTP account.
# Over the limit: 429 + Retry-After. A malformed value fails loudly (500), never unlimited.
# SEND_RATE_LIMIT=100/min

# ==========================================
# Removed — no longer read by the code:
#   SMTP_USER, SMTP_PASSWORD, SENDER_EMAIL, HOST
#     -> SMTP credentials are per user, encrypted in D1,
#        managed via the smtp-config module.
#   API_KEY
#     -> API keys are per user (api-keys module, Better Auth),
#        sent as x-api-key or Authorization: Bearer.
#   INNGEST_DEV
#     -> delivery now runs on Cloudflare Workflows, not Inngest.
#   PORT
#     -> SMTP port is stored per configuration (smtp-config module).
# ==========================================
