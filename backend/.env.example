# ==========================================
# MakiSend Worker environment variables
# Local: fill in real values (cp .env.example .env)
# Prod: set secrets with `wrangler secret put <NAME>` (see README)
# ==========================================

# --- Security / encryption (required) ---
# AES-256 encryption key. 64-character hex string (32 bytes).
# Generate with: openssl rand -hex 32
AES_256_KEY=your_64_character_hexadecimal_string_here

# --- Better Auth (required) ---
# Secret used by Better Auth to sign sessions and tokens.
BETTER_AUTH_SECRET=change_me_to_a_long_random_string
# Backend URL of this Worker.
BETTER_AUTH_URL=http://localhost:8787
# Frontend origin allowed for CORS / redirects.
FRONTEND_URL=http://localhost:4321

# --- Inngest ---
# 1 = use the local Inngest dev server. Remove/0 in production.
INNGEST_DEV=1

# --- nodemailer ---
# SMTP port for SmtpEmailTransport (wrangler.jsonc also sets PORT=465).
PORT=465

# ==========================================
# Removed — no longer read by the code:
#   SMTP_USER, SMTP_PASSWORD, SENDER_EMAIL, HOST
#     -> SMTP credentials are per user, encrypted in D1,
#        managed via the smtp-config module.
#   API_KEY
#     -> API keys are per user (api-keys module, Better Auth),
#        sent as x-api-key or Authorization: Bearer.
# ==========================================
