# Copy to .env next to compose.vps.yml and fill in. Never commit the real file.

# Your domain, with an A record pointing at the VPS (Caddy fetches its certificate for it).
DOMAIN=mail.example.com
BETTER_AUTH_URL=https://mail.example.com
FRONTEND_URL=https://mail.example.com

# openssl rand -hex 32 — keep a copy: data encrypted with a lost key cannot be read again.
ENCRYPTION_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: pin a release (default: latest), e.g. 0.3.0
# MAKISEND_VERSION=0.3.0
# Optional: per-API-key send quota, e.g. 100/min or 5000/day
# SEND_RATE_LIMIT=
# Optional: "off" never contacts GitHub for new releases
# UPDATE_CHECK=on
