# ==========================================
# SMTP Configuration (Email Sending)
# ==========================================
# Le nom d'utilisateur de ton serveur SMTP (souvent ton adresse email ou un identifiant API)
SMTP_USER=your_smtp_username_here

# Le mot de passe de ton serveur SMTP (ou un mot de passe d'application)
SMTP_PASSWORD=your_smtp_password_here

# L'adresse email qui apparaîtra comme expéditeur (ex: noreply@tondomaine.com)
SENDER_EMAIL=noreply@yourdomain.com

# Le nom d'hôte de ton serveur SMTP (ex: smtp.gmail.com, smtp.sendgrid.net, smtp.resend.com)
HOST=smtp.example.com

# Le port du serveur SMTP (généralement 587 pour TLS, 465 pour SSL, ou 2525)
PORT=587

# ==========================================
# Security / Encryption
# ==========================================
# Clé de chiffrement AES-256. Doit être une chaîne hexadécimale de 64 caractères (32 octets).
# Tu peux en générer une avec la commande : openssl rand -hex 32
AES_256_KEY=your_64_character_hexadecimal_string_here