# ==========================================
# SMTP Configuration (Email Sending)
# ==========================================
# Your SMTP server username (often your email address or API identifier)
SMTP_USER=your_smtp_username_here

# Your SMTP server password (or app password)
SMTP_PASSWORD=your_smtp_password_here

# The email address displayed as sender (e.g. noreply@yourdomain.com)
SENDER_EMAIL=noreply@yourdomain.com

# Your SMTP server hostname (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.resend.com)
HOST=smtp.example.com

# Your SMTP server port (usually 587 for TLS, 465 for SSL, or 2525)
PORT=587

# ==========================================
# Security / Encryption
# ==========================================
# AES-256 encryption key. Must be a 64-character hexadecimal string (32 bytes).
# Generate one with: openssl rand -hex 32
AES_256_KEY=your_64_character_hexadecimal_string_here

# API key for securing the /send-email endpoint.
# Provide it in the header `x-api-key` or `Authorization: Bearer <API_KEY>`.
# NOTE: the auth middleware implementation is currently a TODO stub.
API_KEY=your_random_api_key_here
