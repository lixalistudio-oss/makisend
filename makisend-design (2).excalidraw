      "roundness": null,
      "seed": 833575921,
      "version": 720,
      "versionNonce": 1472995057,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783605203016,
      "link": null,
      "locked": false,
      "text": "Je peux exécuté plusieurs actions en parralèle et en même temps.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Je peux exécuté plusieurs actions en parralèle et en même temps.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OO1CN0-hDEW6M7YsU7Fpr",
      "type": "text",
      "x": 4570.760029776624,
      "y": 1043.8246670691415,
      "width": 1165.859619140625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
