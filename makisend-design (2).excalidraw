      "seed": 11664319,
      "version": 571,
      "versionNonce": 735668497,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1783605203016,
      "link": null,
      "locked": false,
      "text": "Je m'excute toujours pendant que je peux aussi attendre la réponse\nd'autres actions.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Je m'excute toujours pendant que je peux aussi attendre la réponse\nd'autres actions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hOqRk_fKhDgWNqmaNHoBv",
      "type": "text",
      "x": 4580.365760435524,
      "y": 745.9382078245492,
      "width": 1137.0595703125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
