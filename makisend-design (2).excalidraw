      "lineHeight": 1.25
    },
    {
      "id": "1MjqxIkAWeyHRLPewkdVq",
      "type": "text",
      "x": 4580.226772984451,
      "y": 443.49169934923816,
      "width": 1194.15576171875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
