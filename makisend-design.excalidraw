      "boundElements": [],
      "updated": 1792742834136,
      "link": null,
      "locked": false,
      "text": "SendEmailWorkflow — durable, 1 instance / email\nreloads and decrypts the content from D1\ncleans the HTML (sanitize-html)\nSMTP: 1 attempt + 3 retries, 30 s apart\npermanent error (auth, TLS, DNS, 5xx) ⇒ stop\nsuccess ⇒ \"sent\" history + log completed\nfinal failure ⇒ \"failed\" + DLQ",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ar-workflow",
      "originalText": "SendEmailWorkflow — durable, 1 instance / email\nreloads and decrypts the content from D1\ncleans the HTML (sanitize-html)\nSMTP: 1 attempt + 3 retries, 30 s apart\npermanent error (auth, TLS, DNS, 5xx) ⇒ stop\nsuccess ⇒ \"sent\" history + log completed\nfinal failure ⇒ \"failed\" + DLQ",
      "autoResize": true,
      "lineHeight": 1.25
    },
