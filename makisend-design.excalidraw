      "seed": 701343069,
      "version": 1,
      "versionNonce": 1243437543,
      "index": "a0002",
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792742834136,
      "link": null,
      "locked": false,
      "text": "A single Cloudflare Worker serves the dashboard and the API. Sending is asynchronous: the HTTP request stores the email in D1 and queues it;\na durable Workflow then sends it over SMTP through the user's provider.\nEverything runs on Cloudflare: Workers, D1, Queues, Workflows, Cron Triggers and static assets.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single Cloudflare Worker serves the dashboard and the API. Sending is asynchronous: the HTTP request stores the email in D1 and queues it;\na durable Workflow then sends it over SMTP through the user's provider.\nEverything runs on Cloudflare: Workers, D1, Queues, Workflows, Cron Triggers and static assets.",
      "autoResize": true,
      "lineHeight": 1.25
    },
