    },
    {
      "type": "text",
      "id": "ar-sub",
      "x": 163,
      "y": 4972,
      "width": 1680.0,
      "height": 50.0,
      "angle": 0,
      "strokeColor": "#6E6A63",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2038058181,
      "version": 1,
      "versionNonce": 1010539423,
      "index": "b1I",
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792742016394,
      "link": null,
      "locked": false,
      "text": "A single Cloudflare Worker serves the dashboard and the API. Sending is asynchronous: the HTTP request stores the email in D1 and queues it;\na durable Workflow then sends it over SMTP through the user's provider. Replaces the outdated \"Production Architecture\" (Inngest) diagram.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single Cloudflare Worker serves the dashboard and the API. Sending is asynchronous: the HTTP request stores the email in D1 and queues it;\na durable Workflow then sends it over SMTP through the user's provider. Replaces the outdated \"Production Architecture\" (Inngest) diagram.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "ar-legend",
      "x": 163,
      "y": 5038,
      "width": 1219.2,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#6E6A63",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1400901356,
      "version": 1,
      "versionNonce": 1589204845,
      "index": "b1J",
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792742016394,
      "link": null,
      "locked": false,
      "text": "Teal = processing in the Worker · Gold = Cloudflare data (D1, Queues) · Grey = external actors and context · Red = known limits",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Teal = processing in the Worker · Gold = Cloudflare data (D1, Queues) · Grey = external actors and context · Red = known limits",
      "autoResize": true,
      "lineHeight": 1.25
    },
