      "link": null,
      "locked": false,
      "text": "queue() — consumer\n1 message = 1 Workflow\n(instance id = emailId,\na duplicate is rejected)\nack after create();\notherwise retry 5 s × 2ⁿ;\nafter 4 failures the Queue\nmoves it to the DLQ",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ar-consumer",
      "originalText": "queue() — consumer\n1 message = 1 Workflow\n(instance id = emailId,\na duplicate is rejected)\nack after create();\notherwise retry 5 s × 2ⁿ;\nafter 4 failures the Queue\nmoves it to the DLQ",
      "autoResize": true,
      "lineHeight": 1.25
    },
