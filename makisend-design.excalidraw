      "updated": 1792742016394,
      "link": null,
      "locked": false,
      "text": "Technical architecture — MakiSend (dev branch, October 2026)",
      "fontSize": 44,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Technical architecture — MakiSend (dev branch, October 2026)",
      "autoResize": true,
