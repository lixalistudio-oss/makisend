      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jobs: tasks that run in a deferred way\nQueues: a waiting line of tasks\nEvents: events that can trigger Jobs",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
