    {
      "type": "text",
      "id": "ar-s2-sub",
      "x": 60,
      "y": 1523.0,
      "width": 1814.3999999999999,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#6E6A63",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 661434098,
      "version": 1,
      "versionNonce": 1158971385,
      "index": "a0067",
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792742834136,
      "link": null,
      "locked": false,
      "text": "Each step.do() is checkpointed by Cloudflare Workflows: if the Worker is evicted, the instance resumes after the last completed step.\nDatabase steps retry twice (2 s); the SMTP step retries 3 times (30 s) and is the only step that talks to the provider, so a D1 failure can never trigger a second send.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each step.do() is checkpointed by Cloudflare Workflows: if the Worker is evicted, the instance resumes after the last completed step.\nDatabase steps retry twice (2 s); the SMTP step retries 3 times (30 s) and is the only step that talks to the provider, so a D1 failure can never trigger a second send.",
      "autoResize": true,
      "lineHeight": 1.25
    },
