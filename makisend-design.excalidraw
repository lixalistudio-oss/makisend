    {
      "type": "text",
      "id": "ar-p-flow-t",
      "x": 185,
      "y": 6295.0,
      "width": 1112.3999999999999,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#12100D",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1436961839,
      "version": 1,
      "versionNonce": 731258806,
      "index": "b2L",
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792742016394,
      "link": null,
      "locked": false,
      "text": "The journey of an email\n1. The client calls POST /send-email with its API key (and, optionally, an Idempotency-Key).\n2. The key determines the user and the SMTP configuration to use; none of it comes from the body.\n3. The Worker encrypts recipient and content, writes the \"pending\" log to D1, then queues { emailId }.\n4. The client gets 202 right away: the actual send has not happened yet.\n5. The consumer starts one Workflow per email; Cloudflare replays it step by step if it is interrupted.\n6. The Workflow sends over SMTP. Every step appends a row to email_histories, shown in the dashboard.\n7. Transient error: 3 more attempts, 30 s apart. Permanent error or exhausted budget: \"failed\" + DLQ.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ar-p-flow",
      "originalText": "The journey of an email\n1. The client calls POST /send-email with its API key (and, optionally, an Idempotency-Key).\n2. The key determines the user and the SMTP configuration to use; none of it comes from the body.\n3. The Worker encrypts recipient and content, writes the \"pending\" log to D1, then queues { emailId }.\n4. The client gets 202 right away: the actual send has not happened yet.\n5. The consumer starts one Workflow per email; Cloudflare replays it step by step if it is interrupted.\n6. The Workflow sends over SMTP. Every step appends a row to email_histories, shown in the dashboard.\n7. Transient error: 3 more attempts, 30 s apart. Permanent error or exhausted budget: \"failed\" + DLQ.",
      "autoResize": true,
      "lineHeight": 1.25
    },
