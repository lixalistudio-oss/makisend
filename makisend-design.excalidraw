      "updated": 1792742016394,
      "link": null,
      "locked": false,
      "text": "POST /send-email — API key\n1. apiKeyMiddleware: key → user\n    → SMTP config linked to the key\n2. Idempotency-Key (replay / 409)\n3. Zod + {{var}} template rendering\n4. encrypts to, text, html (AES-GCM)\n5. pending log + content → D1\n6. Queue.send({ emailId }) → 202",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ar-send",
      "originalText": "POST /send-email — API key\n1. apiKeyMiddleware: key → user\n    → SMTP config linked to the key\n2. Idempotency-Key (replay / 409)\n3. Zod + {{var}} template rendering\n4. encrypts to, text, html (AES-GCM)\n5. pending log + content → D1\n6. Queue.send({ emailId }) → 202",
      "autoResize": true,
      "lineHeight": 1.25
    },
