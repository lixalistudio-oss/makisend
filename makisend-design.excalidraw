    {
      "type": "text",
      "id": "ar-p-limits-t",
      "x": 2602,
      "y": 6551.0,
      "width": 842.4,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#12100D",
      "backgroundColor": "transparent",
