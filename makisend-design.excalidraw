      "version": 1,
      "versionNonce": 607755180,
      "index": "b1J",
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792741002207,
      "link": null,
      "locked": false,
      "text": "Teal = traitement dans le Worker · Or = données Cloudflare (D1, Queues) · Gris = acteurs externes et contexte · Rouge = limites connues",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Teal = traitement dans le Worker · Or = données Cloudflare (D1, Queues) · Gris = acteurs externes et contexte · Rouge = limites connues",
      "autoResize": true,
      "lineHeight": 1.25
    },
