{
  "name": "MakiSend",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "backend",
  "runServices": ["backend", "frontend"],
  "workspaceFolder": "/workspace",
  "forwardPorts": [8787],
  "postCreateCommand": "pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "astro.astro",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
